@startuml
!include _style.iuml

start
$FAIL:**Error during execution**
(socket already connected);
note right
  Must happen after connect();
  failing earlier crashes host app.
end note

partition "Talk to Purpose" {
    :Reply **error 100** + errorText;
    note right
        The host app shows errorText,
        if it shows errors at all.
    end note
    :Close the socket;
}

partition "After the socket is closed" {
    :Critical notification
    "Uguu upload failed";
    :exit 1;
}
stop
@enduml
